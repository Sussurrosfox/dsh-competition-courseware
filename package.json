{
  "name": "@local/competition-courseware",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "竞赛教研与学案制作流水线 (LangGraph Competition Courseware)",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "launcher.py",
    "start_ui.bat",
    "workflow",
    "scripts",
    "prompts",
    "schemas",
    "templates",
    "references",
    "README.md",
    "SKILL.md",
    "USER_GUIDE.md",
    "AGENTS.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}