{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skills-c-v2.local/architect.schema.json",
  "title": "ArchitectPlan",
  "description": "双轨研学剧本架构师输出（teaching/architect-plan.json）。契约 2.4.0：唯一计划形态为 full_lesson（problems[] 逐题规划）；旧 single_problem 形态与 warmup_task / subquestion_tasks 旧结构已删除，不保留 legacy 兼容。默认每个题只有一个高内聚 task-<qid>（task_id == \"task-\" + problem_id），小问属于 task 内部（teaching/generated/<qid>-student-task.json 的 subquestions）。section writer 使用 section-plan.schema.json，不使用本 schema。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "brief_id",
    "brief_revision",
    "plan_scope",
    "problems",
    "forbidden_feature_refs",
    "verification_status"
  ],
  "properties": {
    "schema_version": {"const": "2.4.0"},
    "brief_id": {"type": "string", "minLength": 1},
    "brief_revision": {"type": "integer", "minimum": 1},
    "plan_scope": {
      "type": "string",
      "enum": ["full_lesson"],
      "description": "计划粒度。2.4.0 起仅支持 full_lesson（problems[] 逐题规划）。"
    },
    "problems": {
      "type": "array",
      "minItems": 1,
      "description": "每题独立规划：恰好一个 task-<qid>，小问在 task 内部。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["problem_id", "source_refs", "student_track", "teacher_track", "blocks"],
        "properties": {
          "problem_id": {"type": "string", "minLength": 1},
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/relPath"}
          },
          "student_track": {"$ref": "#/$defs/studentTrack"},
          "teacher_track": {"$ref": "#/$defs/teacherTrack"},
          "blocks": {
            "type": "array",
            "minItems": 1,
            "description": "映射到 materials.json 的统一 block 规划。",
            "items": {"$ref": "#/$defs/blockPlan"}
          }
        }
      }
    },
    "forbidden_feature_refs": {
      "type": "array",
      "items": {"type": "string"},
      "description": "禁泄露特征 ID 列表。"
    },
    "verification_status": {
      "type": "string",
      "enum": ["pending", "verified", "needs_evidence", "refuted"]
    },
    "execution_metadata": {
      "type": "object",
      "description": "子 Agent 运行时溯源签名（UUID 仅作索引，真实性由 broker receipt 决定）",
      "additionalProperties": false,
      "required": ["agent_role", "subagent_conversation_id"],
      "properties": {
        "agent_role": {
          "type": "string",
          "enum": ["architect"]
        },
        "subagent_conversation_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "relPath": {
      "type": "string",
      "pattern": "^[^\\\\]+$"
    },
    "studentTrack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tasks"],
      "properties": {
        "tasks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "description": "本题唯一的高内聚任务（task-<qid>）。小问不属于本层，属于 teaching/generated/<qid>-student-task.json 的 subquestions。",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["task_id", "student_evidence", "worksheet_ref"],
            "properties": {
              "task_id": {
                "type": "string",
                "pattern": "^task-[A-Za-z0-9_-]+$",
                "description": "规范值 task-<problem_id>；check_architect.py 逐题核对。"
              },
              "student_evidence": {
                "type": "string",
                "minLength": 1,
                "description": "学生应留下的证据（任务级描述，不写答案）。"
              },
              "worksheet_ref": {"$ref": "#/$defs/relPath"}
            }
          }
        }
      }
    },
    "teacherTrack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeline_minutes", "proof_ref", "variants"],
      "properties": {
        "timeline_minutes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["phase", "time_minutes", "activity", "pause_point"],
            "properties": {
              "phase": {"type": "string", "minLength": 1},
              "time_minutes": {"type": "integer", "minimum": 0},
              "activity": {"type": "string"},
              "pause_point": {"type": "boolean"}
            }
          }
        },
        "radar_checkpoints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["error_type", "observation_signal", "guidance_script"],
            "properties": {
              "error_type": {"type": "string"},
              "observation_signal": {"type": "string"},
              "guidance_script": {"type": "string"}
            }
          }
        },
        "prompting_questions": {
          "type": "array",
          "items": {"type": "string"}
        },
        "proof_ref": {"$ref": "#/$defs/relPath"},
        "variants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["variant_id", "kind", "statement", "pedagogical_purpose"],
            "properties": {
              "variant_id": {"type": "string"},
              "kind": {"type": "string", "enum": ["consolidation", "elevation"]},
              "statement": {"type": "string"},
              "pedagogical_purpose": {"type": "string"}
            }
          }
        }
      }
    },
    "blockPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_id",
        "kind",
        "level",
        "audience",
        "available_after",
        "delivery_channel",
        "source_refs",
        "content_ref",
        "task_id"
      ],
      "properties": {
        "block_id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "level": {
          "type": "string",
          "enum": ["L0", "L1", "L2"]
        },
        "audience": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["student", "teacher"]}
        },
        "available_after": {"type": "string", "minLength": 1},
        "delivery_channel": {
          "type": "string",
          "enum": ["in_main", "teacher_only"]
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/relPath"}
        },
        "content_ref": {"$ref": "#/$defs/relPath"},
        "task_id": {
          "type": ["string", "null"],
          "description": "对应 task-<qid>；纯教师证明块等无对应任务时为 null。"
        }
      }
    }
  }
}
