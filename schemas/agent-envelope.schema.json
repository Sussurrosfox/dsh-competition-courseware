{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skills-c-v5.local/agent-envelope.schema.json",
  "title": "AgentEnvelope",
  "description": "子代理返回给主模型的小型统一信封（§5.4）。主模型不需要阅读完整候选文本，只根据 envelope 与 run-summary 调度。candidate_conclusion/changed_paths/output_digests/issues/next_action/attempt_id。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capability_id",
    "attempt_id",
    "agent_role",
    "candidate_conclusion",
    "changed_paths",
    "output_digests",
    "next_action",
    "execution_metadata"
  ],
  "properties": {
    "schema_version": {"const": "2.4.0"},
    "capability_id": {
      "type": "string",
      "pattern": "^cap-[A-Za-z0-9_-]+$",
      "description": "本 envelope 对应的能力令牌 ID"
    },
    "run_id": {"type": "string", "pattern": "^run-[A-Za-z0-9_-]+$"},
    "section_id": {"type": "string", "pattern": "^S[0-9]+$"},
    "question_id": {"type": "string", "pattern": "^P?[0-9]+$"},
    "attempt_id": {
      "type": "integer",
      "minimum": 1,
      "description": "修复只能产生新 attempt，不覆盖旧 attempt"
    },
    "agent_role": {
      "type": "string",
      "enum": ["section-writer", "student-task", "teacher-solution", "reviewer"]
    },
    "candidate_conclusion": {
      "type": "string",
      "enum": ["completed", "needs_evidence", "no_useful_result", "failed"],
      "description": "候选结论；failed 不能冒充 no_useful_result"
    },
    "conclusion_reason": {"type": "string"},
    "changed_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/stagingPath"},
      "description": "本次写入的 staging 相对路径；禁止绝对路径 / ../ / canonical"
    },
    "output_digests": {
      "type": "object",
      "minProperties": 1,
      "description": "staging 路径 -> 输出 SHA-256，供 accept 校验",
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "issues": {
      "type": "array",
      "description": "发现的问题列表（含 repair 目标字段）",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "description"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "target_path": {"$ref": "#/$defs/stagingPath"}
        }
      }
    },
    "next_action": {
      "type": "string",
      "enum": ["accept", "repair", "block", "release", "research_back"],
      "description": "建议编排器执行的动作"
    },
    "execution_metadata": {
      "type": "object",
      "description": "§9 Secure Skills Upgrade: Mandatory proof of real sub-agent invocation",
      "additionalProperties": false,
      "required": ["subagent_conversation_id", "worker_session_id"],
      "properties": {
        "subagent_conversation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "description": "RFC 4122 UUID from invoke_subagent, must exist in platform transcript"
        },
        "worker_session_id": {
          "type": "string",
          "minLength": 1
        },
        "nonce_verified": {
          "type": "boolean",
          "description": "Whether challenge-response nonce was verified"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"candidate_conclusion": {"enum": ["no_useful_result", "failed"]}}},
      "then": {"required": ["conclusion_reason"]}
    }
  ],
  "$defs": {
    "stagingPath": {
      "type": "string",
      "pattern": "^run/[A-Za-z0-9_-]+/sections/S[0-9]+/staging/",
      "not": {"pattern": "(^|/)\\.\\./"}
    }
  }
}
